{
  "name": "elm-combinators",
  "version": "2.0.0",
  "description": "Combinatory logic in Elm",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "author": {
    "name": "James Robb",
    "url": "https://github.com/jamesrweb",
    "email": "47126579+jamesrweb@users.noreply.github.com"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "combinatory-logic",
    "elm",
    "combinators-calculus",
    "elm-package",
    "functional-compositions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesrweb/elm-combinators.git"
  },
  "bugs": {
    "url": "https://github.com/jamesrweb/elm-combinators/issues"
  },
  "homepage": "https://github.com/jamesrweb/elm-combinators#readme",
  "scripts": {
    "format": "elm-format src/ --yes && biome check --write",
    "lint": "elm-verify-examples && elm-format src/ --validate && elm-review && biome check",
    "test": "elm-verify-examples && elm-test",
    "coverage": "elm-coverage --silent --open --force",
    "documentation": "elm-doc-preview",
    "postinstall": "rm -rf elm-stuff && ELM_HOME=$(pwd)/elm-home elm-janitor-apply-patches --all --noconsole || echo 'patching failed (non-critical)'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "elm-coverage": "^0.4.1",
    "elm-doc-preview": "^6.0.1",
    "elm-format": "^0.8.8",
    "elm-janitor-apply-patches": "^1.1.0",
    "elm-json": "^0.2.13",
    "elm-review": "^2.13.5",
    "elm-test": "0.19.3-0",
    "elm-verify-examples": "^6.0.3"
  },
  "dependencies": {
    "elm": "0.19.3-0"
  },
  "main": "index.js"
}
